{
  "name": "logical-fallacy-detector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "description": "Logical fallacy detection tool based on Walton's Argumentation Schemes and the LOGIC dataset (Jin et al., 2022).",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "express": "4.21.0",
    "express-rate-limit": "7.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "vite": "5.4.8"
  }
}
